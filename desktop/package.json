{
  "name": "dsh-client-desktop",
  "version": "2.1.2",
  "description": "DSH 客户端桌面版（Electron）：内部拉起 dsh web，弹窗置顶提醒",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "author": "WZX",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.dsh.client",
    "productName": "DeepSeekClient",
    "directories": {
      "output": "release"
    },
    "files": [
      "**/*",
      "!node/**",
      "!dsh-runtime/**",
      "!**/*.log"
    ],
    "extraResources": [
      {
        "from": "node",
        "to": "node"
      },
      {
        "from": "dsh-runtime",
        "to": "dsh-runtime"
      },
      {
        "from": "gate",
        "to": "gate"
      },
      {
        "from": "presets",
        "to": "presets"
      },
      {
        "from": "plugin-static",
        "to": "plugin-static"
      },
      {
        "from": "icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "target": ["nsis"],
      "icon": "icon.ico",
      "signAndEditExecutable": false,
      "electronLanguages": ["zh-CN", "en-US"]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DeepSeekClient",
      "license": "说明.txt",
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "installerHeaderIcon": "icon.ico",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "include": "installer.nsh",
      "artifactName": "DeepSeek-Client-Setup-${version}.exe"
    }
  }
}
