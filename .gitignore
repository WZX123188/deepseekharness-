# dependencies（仅应用自身的依赖目录，避免 542MB 进 git；内置 Node 运行时整目录由下方 desktop/node/ 管理）
desktop/node_modules/

# 内置 DSH 运行时（245MB，npm install 生成，不进 git；package.json 保留）
desktop/dsh-runtime/node_modules/
desktop/dsh-runtime/install.log
desktop/dsh-runtime/package-lock.json

# logs
*.log

# OS
Thumbs.db
.DS_Store

# desktop build output (installer / unpacked app)
desktop/release/
desktop/install.log
desktop/build.log
desktop/node/

# 敏感：凭证 / 设置 / 本地状态（绝不能提交到仓库）
.credentials.yaml
settings.yaml
dsh-client-*.json
dsh-market.json
.env
.env.*
*.local

# 隔离测试环境（运行时数据，不进 git）
desktop/test-env/.dsh/
desktop/test-env/app/
desktop/test-env/out.log
desktop/test-env/err.log
desktop/test-env/pid.txt
